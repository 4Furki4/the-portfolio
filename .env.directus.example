# Local Directus instance used by `docker compose -f docker-compose.directus.yml`.
DIRECTUS_URL=http://localhost:8065
DIRECTUS_PUBLIC_URL=http://localhost:8065
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=replace-with-a-long-local-password
DIRECTUS_SECRET=replace-with-at-least-32-random-characters
DIRECTUS_ASSET_TOKEN=replace-with-at-least-32-random-characters
DIRECTUS_DB_PASSWORD=replace-with-a-long-local-database-password
PUBLIC_URL=http://localhost:8055
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-the-same-long-local-password
SECRET=replace-with-the-same-32-random-characters
DB_PASSWORD=replace-with-the-same-local-database-password
POSTGRES_PASSWORD=replace-with-the-same-local-database-password
PORTFOLIO_REVALIDATE_URL=http://host.docker.internal:3000/api/revalidate/directus
PORTFOLIO_REVALIDATE_SECRET=replace-with-at-least-32-random-characters

# Optional on Directus v12 Core. Add an Innovation Grant key only if you use one.
# LICENSE_KEY=
